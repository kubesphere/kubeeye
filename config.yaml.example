# KubeEye 配置文件示例
# 保存为 config.yaml 使用

# 默认集群名称
default_cluster: demo

# 结果保存目录
results_dir: "data/results"

# 启用的巡检类型
enable_node_inspection: true
enable_prometheus_inspection: true
enable_opa_inspection: true

# 节点配置
nodes:
  - name: node1
    ip: 192.168.1.101
    port: 22
    user: root
    auth_type: password  # 可选: password, key, key_file
    password: "demo_password"  # 如果auth_type为password
    # key: "ssh private key content"  # 如果auth_type为key
    # key_file: "~/.ssh/id_rsa"  # 如果auth_type为key_file
    # sudo: true  # 是否使用sudo执行命令
    
  - name: node2
    ip: 192.168.1.102
    port: 22
    user: ubuntu
    auth_type: key_file
    key_file: "~/.ssh/id_rsa"
    sudo: true
    
# Prometheus配置
prometheus:
  url: "http://prometheus.example.com:9090"
  timeout: 10
  # token: "prometheus_token"  # 如果需要认证
  # verify_ssl: false  # 如果使用自签名证书
  
# OPA规则检查配置
opa:
  kubeconfig: "~/.kube/config"  # Kubernetes配置文件路径
  # context: "my-context"  # 可选：指定Kubernetes上下文
  # in_cluster: false  # 是否在集群内运行
  opa_path: "opa"  # OPA命令行工具路径
  
# 日志配置
logging:
  level: info  # debug, info, warning, error, critical
  file: "kubeeye.log"
  # 如果为false，则不记录到文件，只输出到控制台
  file_logging: true
  # 日志文件大小和保留策略
  max_size_mb: 10
  backup_count: 3
